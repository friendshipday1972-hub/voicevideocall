{
  "expo": {
    "name": "Baatein",
    "slug": "friendship",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "baatein",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.baatein"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFE4E6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.baatein"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF1F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0B0710"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#FFF7F8",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "friendshipchattings-team",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "96c4bec4-f4a2-4e78-8007-57f38194f557"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/96c4bec4-f4a2-4e78-8007-57f38194f557"
    }
  }
}
